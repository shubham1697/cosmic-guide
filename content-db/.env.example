# ──────────────────────────────────────────────────────────────
# CosmicGuide Content DB — Environment Variables
# Copy to .env and fill in your values before running:
#   docker compose -f docker-compose.content-db.yml up -d
# ──────────────────────────────────────────────────────────────

# ── PostgreSQL ────────────────────────────────────────────────
POSTGRES_DB=cosmicguide_content
POSTGRES_USER=cosmicguide
POSTGRES_PASSWORD=change_me_to_a_strong_password
CONTENT_DB_PORT=5432

# ── Gemini AI (required for content generation) ──────────────
GEMINI_API_KEY=your-gemini-api-key-here
AI_MODEL=gemini-2.5-flash-lite

# ── Schedule ─────────────────────────────────────────────────
# Time to generate new daily content (HH:MM, 24h format)
DAILY_REFRESH_TIME=00:05

# ── Ollama (optional, for story generation) ──────────────────
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=mistral:latest

# ── Logging ──────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── pgAdmin (only used with --profile admin) ─────────────────
PGADMIN_PORT=5050
PGADMIN_EMAIL=admin@cosmicguide.local
PGADMIN_PASSWORD=admin
