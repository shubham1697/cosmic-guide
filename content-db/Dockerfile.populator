# Lightweight image for the daily populator — no need for swisseph
# since population only calls Gemini API + writes to PostgreSQL.
FROM python:3.12-slim

WORKDIR /app

# Only install what the populator needs
COPY backend/requirements.txt /tmp/requirements.txt
RUN pip install --no-cache-dir \
    sqlalchemy \
    psycopg2-binary \
    python-dotenv \
    google-genai \
    requests \
    $(grep -E "^pydantic" /tmp/requirements.txt)

# Copy the backend code
COPY backend/ .

# The entrypoint is set in docker-compose (cron_runner.py or populate_daily.py)
CMD ["python", "cron_runner.py"]
