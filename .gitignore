.DS_Store

# Editors / IDEs
.idea/
.vscode/

# Flutter / Dart
mobile-app/build/
mobile-app/android/build/
mobile-app/android/.gradle/
mobile-app/.dart_tool/
mobile-app/ios/Pods/
mobile-app/ios/.symlinks/
mobile-app/ios/Flutter/Flutter.podspec
mobile-app/ios/Flutter/ephemeral/
# Release signing — keystore passwords, never commit
mobile-app/android/key.properties
*.jks
*.keystore

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.venv/
venv/

# Local environment and runtime artifacts
.env
.server.pid
*.pid

# Backend local state
backend/__pycache__/
backend/venv/
backend/*.db
backend/*.log
*.log

# Audit logs (including rotated files audit.log.1, audit.log.2, …)
backend/logs/

# Dashboard generated snapshots
dashboard/data/

# Firebase / FCM
# Server-side service-account key (SECRET — grants send access, never commit)
backend/secrets/
# Client config (contains project API keys; commit later if desired).
# Globbed, not path-pinned: downloaded copies often land at the repo root.
google-services*.json
GoogleService-Info*.plist
mobile-app/lib/firebase_options.dart
