# .env (copy to .env and fill in real values for production)
DATABASE_URL=sqlite:///./cosmicguide.db

# Operator key for /admin/* and the notification broadcast routes.
# Leave unset and those routes stay disabled (503) rather than open.
ADMIN_API_KEY=

# AI content generation (Google Gemini)
# Get your key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
AI_MODEL=gemini-2.5-flash-lite   # or gemini-2.5-flash for higher quality

# Preferred LLM backend: auto | gemini | ollama | iphone
# auto → Gemini (if key set) → Ollama → iPhone LLM
AI_PROVIDER=auto

# Local Ollama instance (used when Gemini is unavailable)
OLLAMA_BASE_URL=http://192.168.29.159:11434
OLLAMA_MODEL=gemma3:4b

# iPhone-hosted LLM — OpenAI-compatible endpoint (see iphone_llm/iphone-llm.py)
IPHONE_LLM_BASE_URL=http://192.168.29.162:8080/v1
IPHONE_LLM_MODEL=base
IPHONE_LLM_API_KEY=not-needed

# Logging level: DEBUG | INFO | WARNING | ERROR  (default: INFO)
# DEBUG logs every SQL statement — do not use it in production.
LOG_LEVEL=INFO

# Publish /docs, /redoc and /openapi.json (default: false).
ENABLE_DOCS=false

# In-process daily reminder push (default: false). The app schedules its own
# on-device reminder at the user's local time; turning this on as well sends a
# second notification on container time.
ENABLE_SCHEDULER=false
